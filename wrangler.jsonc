// Bet This Guy site Worker. Built by `npm run build` into dist/server/index.js.
// Deployed by Cloudflare Workers Builds from this repository's main branch.
{
  "name": "bet-this-guy",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bet-this-guy",
      "database_id": "d05b3e77-7dd7-4ec1-921f-06d5afff0cc9",
      "migrations_dir": "drizzle"
    }
  ],
  // Per-visitor limits on paid provider lookups the cache can't answer
  // (see allowProviderCall in worker/index.template.js).
  "ratelimits": [
    { "name": "UNKNOWN_EVENT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "PLAYER_STATS_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  // Pull-request previews (`npx wrangler preview`) get their own empty
  // database and rate-limit counters so they never touch the live record.
  // Preview secrets are separate: `npx wrangler preview base-config secret put <NAME>`.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "bet-this-guy-preview", "database_id": "9b32b659-1c06-4d3d-b4a0-b3bc90bbb669" }
    ],
    "ratelimits": [
      { "name": "UNKNOWN_EVENT_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
      { "name": "PLAYER_STATS_LIMITER", "namespace_id": "1004", "simple": { "limit": 120, "period": 60 } }
    ]
  }
  // Secrets, set in the dashboard or with `npx wrangler secret put <NAME>`:
  // THE_ODDS_API_KEY, BALLDONTLIE_API_KEY, MAINTENANCE_TOKEN
}
